# No OS-specific ignores needed - using single source with conditional destination

# Misc state
.config/nushell/history.txt
private_dot_ssh/config.gcp

# Secrets — never track these, even if `chezmoi add` is accidentally run.
# These files contain OAuth tokens / auth keys that must not land in git.
.config/gh/hosts.yml
.config/atuin/key
.config/atuin/session
.config/atuin/login_session
.config/discord
.config/lmstudio
.netrc

# Defensive patterns for keys/tokens/service accounts. These never belong in
# a public dotfiles repo. Listed as TARGET paths so `chezmoi add` on any of
# these refuses (chezmoi consults this file before adding).
gcp.json
**/*service-account*.json
**/credentials.json
**/*credentials*.json
**/*api*key*
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa
**/id_rsa.*
**/id_ed25519
**/id_ed25519.*
**/id_ecdsa
**/id_ecdsa.*
**/*.kdbx
**/*.kdb
**/.npmrc
**/.pypirc
**/known_hosts

# Opencode config - tracked via template, secrets via extraFile
# dot_config/opencode/opencode.jsonc

# Cache / runtime artefacts some apps drop in tracked dirs
.config/yazi/state
.config/bat/cache

# Runtime plugin installs (TPM manages these) and per-machine app state.
# Were previously tracked; now ignored so chezmoi doesn't try to delete them.
# Whole ~/.tmux is runtime-managed (TPM clones plugins into it); the legacy
# symlink_dot_tmux pointed at a Linux-only path and breaks on macOS.
.tmux
.tmux/**
.local/share/lutris/**
.local/share/nvim/lazy/**
.claude/skills
.claude/hooks
.claude/CLAUDE.md
.claude/settings.json
.config/opencode/AGENTS.md
