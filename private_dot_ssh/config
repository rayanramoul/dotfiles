# ── Includes ───────────────────────────────────────────────────────────────────
Include ~/.colima/ssh_config
Include ~/.ssh/config.gcp

# ── Global defaults ────────────────────────────────────────────────────────────
Host *
    AddKeysToAgent          yes
    IdentitiesOnly          yes
    ServerAliveInterval     60
    ServerAliveCountMax     10
    # Multiplexing: authenticate once, reuse the connection for subsequent sessions
    ControlMaster           auto
    ControlPath             ~/.ssh/sockets/%r@%h:%p
    ControlPersist          10m

# ── Git remotes ────────────────────────────────────────────────────────────────
Host github.com
    HostName        github.com
    User            git
    IdentityFile    ~/.ssh/id_rsa

Host gitlab.com
    HostName        gitlab.com
    User            git
    IdentityFile    ~/.ssh/id_ed25519

# ── GCP GPU servers ────────────────────────────────────────────────────────────
# Common settings for all manually managed GCP instances
Host ray-* tpu a100-* t4*
    IdentityFile            ~/.ssh/google_compute_engine
    UserKnownHostsFile      ~/.ssh/google_compute_known_hosts
    IdentitiesOnly          yes
    CheckHostIP             no
    # Auto-attach (or create) a tmux session named 'main' on connect
    RemoteCommand           tmux new-session -A -s main
    RequestTTY              yes

