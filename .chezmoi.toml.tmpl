[data]
    # OS detection data for templates
    os = "{{ .chezmoi.os }}"

[data.git]
    # Prompted once on `chezmoi init`, stored in ~/.config/chezmoi/chezmoi.toml
    name  = {{ promptStringOnce . "git.name"  "Git author name" "Your Name"        | quote }}
    email = {{ promptStringOnce . "git.email" "Git author email" "you@example.com" | quote }}

# Pipe `chezmoi diff` output through delta for syntax-highlighted, side-by-side
# rendering. delta reads its options (side-by-side, line-numbers, navigate,
# syntax-theme) from the [delta] section of ~/.gitconfig, so no duplicate
# configuration is needed here. --paging=never prevents a nested pager.
[diff]
    pager = "delta --paging=never"

# macOS-specific configuration
[data.darwin]
    libraryPath = "{{ .chezmoi.homeDir }}/Library"

[scriptCondition.darwin]
    command = "test"
    args = ["-d", "{{ .chezmoi.homeDir }}/Library"]

# Platform-specific directory mappings
{{- if eq .chezmoi.os "darwin" }}
[cd."{{ .chezmoi.homeDir }}/Library/Application Support/Cursor"]
    exact = true
    type = "directory"
{{- end }} 