[Unit]
Description=llama.cpp Server with Qwen3.5-9B-Claude-HighIQ IQ4_XS
After=network.target

[Service]
Type=simple
Environment=PATH=/home/rayanramoul/.local/llama-cpp:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/home/rayanramoul/.local/llama-cpp
ExecStart=/home/rayanramoul/.local/llama-cpp/llama-server --model /home/rayanramoul/.local/share/llama-models/Qwen3.5-9B-Claude-HighIQ-IQ4_XS.gguf --ctx-size 120000 --host 0.0.0.0 --port 18081 -ngl 99
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
