[Unit]
Description=llama.cpp Server with qwen3.6-35b IQ4_XS
After=network.target

[Service]
Type=simple
Environment=PATH=/home/rayanramoul/.local/llama-cpp:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/home/rayanramoul/.local/llama-cpp
ExecStart=/home/rayanramoul/.local/llama-cpp/llama-server --model /home/rayanramoul/.local/share/llama-models/qwen3.6-35b-iq4_xs.gguf --ctx-size 65536 --host 0.0.0.0 --port 18081 -ngl 99 
