# ── Identity ───────────────────────────────────────────────────────────────────
[user]
    name  = {{ .git.name }}
    email = {{ .git.email }}

# ── Core ───────────────────────────────────────────────────────────────────────
[core]
    editor     = nvim
    pager      = delta
    autocrlf   = input
    whitespace = fix,trailing-space,cr-at-eol

[credential]
    helper = /usr/local/share/gcm-core/git-credential-manager

# ── Delta (diff pager) ─────────────────────────────────────────────────────────
[delta]
    navigate    = true   # n/N to jump between diff sections
    side-by-side = true
    line-numbers = true
    syntax-theme = Catppuccin Mocha
    file-style   = bold yellow
    hunk-header-style = file line-number syntax

[interactive]
    diffFilter = delta --color-only

# ── Commit ─────────────────────────────────────────────────────────────────────
[commit]
    template = ~/commit-template.txt
    verbose  = true

# ── Diff & Merge ───────────────────────────────────────────────────────────────
[diff]
    context          = 3
    renames          = copies
    interHunkContext = 10
    colorMoved       = default
    tool             = nvimdiff

[merge]
    tool          = nvimdiff
    conflictstyle = diff3

[rerere]
    enabled = true   # remember conflict resolutions

# ── Fetch / Push / Pull ────────────────────────────────────────────────────────
[fetch]
    prune     = true   # auto-remove deleted remote branches
    pruneTags = true

[push]
    autoSetupRemote = true
    default         = current
    followTags      = true

[pull]
    rebase = true

[rebase]
    autoStash = true   # stash dirty state before rebase, pop after

# ── Submodules ─────────────────────────────────────────────────────────────────
[submodule]
    fetchJobs = 16

# ── Log ────────────────────────────────────────────────────────────────────────
[log]
    abbrevCommit = true
    graphColors  = blue,yellow,cyan,magenta,green,red
    date         = human

[blame]
    coloring = highlightRecent
    date     = relative

[status]
    branch          = true
    short           = true
    showStash       = true
    showUntrackedFiles = all

# ── Aliases ────────────────────────────────────────────────────────────────────
[alias]
    # basics
    co   = checkout
    st   = status
    ci   = commit
    cim  = commit -m
    cia  = commit -a
    wip  = commit -m "WIP" -n

    # rebase
    rbi  = rebase -i
    rbc  = rebase --continue
    rba  = rebase --abort

    # pretty log
    lg   = log --oneline --graph --decorate --all
    tree = log --oneline --graph --decorate --all
    ll   = log --stat --abbrev-commit

    # branch housekeeping
    recent = for-each-ref --sort=-committerdate --count=10 --format='%(refname:short)' refs/heads
    dlb    = "!f() { git co main && git pull -p && for b in $(git branch -vv | grep ': gone]' | awk '{print $1}'); do git branch -D $b; done; }; f"

    # open remote in browser
    open   = "!f(){ python -m webbrowser $(git config --get remote.origin.url | sed -Ee 's#(git@|git://)#https://#' -e 's@com:@com/@' -e 's@\\.git@@') | head -n1; }; f"
    board  = "!f(){ python -m webbrowser $(git config --get remote.origin.url | sed -Ee 's#(git@|git://)#https://#' -e 's@com:@com/@' -e 's@\\.git@/-/boards@') | head -n1; }; f"
    issues = "!f(){ python -m webbrowser $(git config --get remote.origin.url | sed -Ee 's#(git@|git://)#https://#' -e 's@com:@com/@' -e 's@\\.git@/-/issues@') | head -n1; }; f"

    # reset local branch to remote
    rh = !git fetch && git reset --hard origin/$(git branch --show-current)

    # undo last commit, keep changes staged
    undo = reset --soft HEAD~1

    # show what changed in last commit
    last = log -1 HEAD --stat

# ── Colors ─────────────────────────────────────────────────────────────────────
[color "blame"]
    highlightRecent = black bold,1 year ago,white,1 month ago,default,7 days ago,blue

[color "branch"]
    current  = magenta bold
    local    = default
    remote   = yellow
    upstream = green
    plain    = blue

[color "diff"]
    meta       = black bold
    frag       = magenta bold
    context    = white
    whitespace = yellow reverse
    old        = red
    new        = green

[color "status"]
    added     = green bold
    changed   = yellow bold
    untracked = red bold
    branch    = magenta bold

[color.decorate]
    HEAD         = red bold
    branch       = blue bold
    tag          = yellow bold
    remoteBranch = magenta
