#!/bin/bash
# Install xontribs (xonsh plugins) loaded by dot_config/xonsh/rc.d/25-xontribs.xsh.
#
# Uses xonsh's own Python interpreter to install — guarantees the xontribs land
# in a site-packages dir that xonsh actually imports from, even if another
# Python (miniconda, pyenv, brew) is earlier in PATH.
set -e

if ! command -v xonsh >/dev/null; then
  echo "xonsh not found — run_onchange_install-packages.sh should run first." >&2
  exit 1
fi

XONSH_PYTHON="$(xonsh -c 'import sys; print(sys.executable)')"
if [ -z "$XONSH_PYTHON" ] || [ ! -x "$XONSH_PYTHON" ]; then
  echo "Could not determine xonsh's Python interpreter." >&2
  exit 1
fi

# --break-system-packages is required on PEP 668 platforms (Arch, recent
# Debian/Ubuntu, Homebrew Python 3.12+). It only affects the user-site install
# semantics — pure-Python xontribs land in ~/.local/lib/.../site-packages
# without touching anything the OS package manager owns.
PIP_FLAGS=(--user --break-system-packages --upgrade)

echo "Installing xontribs into $XONSH_PYTHON..."
"$XONSH_PYTHON" -m pip install "${PIP_FLAGS[@]}" \
  xontrib-fish-completer \
  xontrib-jedi \
  xontrib-cmd-durations
