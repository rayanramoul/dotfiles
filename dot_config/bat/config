# bat configuration. One flag per line, comments allowed.

# Theme. Built-in dark theme that pairs OK with rose-pine.
# To use a custom catppuccin/rose-pine theme:
#   1. git clone https://github.com/rose-pine/bat ~/.config/bat/themes/rose-pine
#   2. bat cache --build
#   3. swap below to: --theme="rose-pine"
--theme="OneHalfDark"

# Style: line numbers + git change markers + filename header.
--style="numbers,changes,header"

# Map chezmoi templates to bash highlighting.
--map-syntax="*.tmpl:Bash"
--map-syntax="*.sh.tmpl:Bash"

# Treat .conf as ini-ish.
--map-syntax="*.conf:INI"
