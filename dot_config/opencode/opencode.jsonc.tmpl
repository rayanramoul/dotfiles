      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:18081/v1"
      },
      "models": {
        "qwen3.6-35b-iq4_xs.gguf": {
          "name": "Qwen 3.6 35B (IQ4_XS) - llama-server",
