[Unit]
Description=llama.cpp Server with Qwen3.6-35B IQ4_XS
After=network.target

[Service]
Type=simple
Environment=PATH=%h/.local/llama-cpp:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=%h/.local/llama-cpp
ExecStart=%h/.local/llama-cpp/llama-server --model %h/.local/share/llama-models/qwen3.6-35b-iq4_xs.gguf --ctx-size 120000 --host 0.0.0.0 --port 18081 -ngl 99
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
