# No OS-specific ignores needed - using single source with conditional destination

# Misc state
.config/nushell/history.txt
.ssh/config.gcp

# Secrets — never track these, even if `chezmoi add` is accidentally run.
# These files contain OAuth tokens / auth keys that must not land in git.
.config/chezmoi/key.txt
.config/gh/hosts.yml
.config/atuin/key
.config/atuin/session
.config/atuin/login_session
.config/discord
.config/lmstudio
.netrc

# Defensive patterns for keys/tokens/service accounts. These never belong in
# a public dotfiles repo. Listed as TARGET paths so `chezmoi add` on any of
# these refuses (chezmoi consults this file before adding).
gcp.json
**/*service-account*.json
**/credentials.json
**/*credentials*.json
**/*api*key*
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa
**/id_rsa.*
**/id_ed25519
**/id_ed25519.*
**/id_ecdsa
**/id_ecdsa.*
**/*.kdbx
**/*.kdb
**/.npmrc
**/.pypirc
**/known_hosts
**/known_hosts.old
**/authorized_keys
# Custom-named SSH private keys (no id_* prefix, so the patterns above miss them).
# `chezmoi add ~/.ssh` warns but still adds these unless listed here.
.ssh/google_compute_engine
.ssh/truenas
.ssh/*.pub

# Opencode config - tracked via template, secrets via extraFile
