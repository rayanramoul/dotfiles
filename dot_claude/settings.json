{
  "model": "opus[1m]",
  "enabledPlugins": {
    "cloudflare@cloudflare": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(ls)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(which:*)",
      "Bash(whereis:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(readlink:*)",

      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(diff:*)",
      "Bash(comm:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",

      "Bash(date)",
      "Bash(date:*)",
      "Bash(uname:*)",
      "Bash(hostname)",
      "Bash(ps:*)",
      "Bash(pgrep:*)",

      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git branch -v)",
      "Bash(git branch -a)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list)",
      "Bash(git remote -v)",
      "Bash(git remote show:*)",
      "Bash(git remote get-url:*)",
      "Bash(git stash list)",
      "Bash(git stash show:*)",
      "Bash(git describe:*)",
      "Bash(git tag)",
      "Bash(git tag -l:*)",
      "Bash(git tag --list:*)",
      "Bash(git shortlog:*)",
      "Bash(git reflog:*)",

      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(uv --version)",
      "Bash(uv tree:*)",
      "Bash(uv pip list)",
      "Bash(uv pip show:*)",
      "Bash(just --list)",
      "Bash(just --show:*)",
      "Bash(ruff --version)",
      "Bash(mypy --version)",
      "Bash(pytest --version)",
      "Bash(pytest --collect-only:*)",
      "Bash(pre-commit --version)",
      "Bash(uvx pre-commit --version)",

      "Bash(gh --version)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",

      "Bash(uvx pre-commit run --all-files)",
      "Bash(uvx pre-commit run --all-files || exit 2)",
      "Bash(if [ -f .pre-commit-config.yaml ]; then uvx pre-commit run --all-files || exit 2; fi)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(git status --porcelain 2>/dev/null)\" ] || exit 0; [ -f .pre-commit-config.yaml ] || exit 0; out=$(uvx pre-commit run --all-files 2>&1) || { printf '%s\\n' \"$out\" >&2; exit 2; }",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "case \"$(uname -s)\" in Darwin) osascript -e 'display notification \"Claude is ready for more action!\" with title \"Claude Code\"' ;; Linux) command -v notify-send >/dev/null 2>&1 && notify-send 'Claude Code' 'Claude is ready for more action!' ;; esac",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
